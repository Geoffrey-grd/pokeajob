{% extends "navbar.twig" %}

{% block content %}
<link rel="stylesheet" href="/assets/pages/profil.css">
<link rel="stylesheet" href="/assets/components/form.css">
<link rel="stylesheet" href="/assets/pages/auth.css">
<link rel="stylesheet" href="/assets/components/card.css">
<div class="page-auth">
    <main>
        <div class="auth-container">
                <div class="job-card job-card--detail">
                    <div class="card__banner">
                        <img class="card__banner-img" src="{{ offer.banner_path }}" alt="Bannière de l'offre {{ offer.id_offer }}">
                        <div class="card__company-logo">
                            <img src="{{ offer.logo_path }}" alt="Logo de {{ offer.company_name }}">
                        </div>
                    </div>

                    <div class="card__body">
                        <h1 class="card__title">{{ offer.offer_object }}</h1>
                        <div class="card__row--type">
                            <img src="images/suitcase.png" alt="suitcase">
                            <h3>{{ offer.company_name }}</h3>
                            {% if role === 'etudiant' %}
                                {% if isinwishlist %}
                                    <a class="card__wishlist" href="/remove_from_wishlist?id_offer={{ offer.id_offer }}">
                                        <img src="images/wishlist_full.png" alt="remove from wishlist">
                                    </a>
                                {% else %}
                                    <a class="card__wishlist" href="/add_to_wishlist?id_offer={{ offer.id_offer }}">
                                        <img src="images/wishlist.png" alt="add to wishlist">
                                    </a>
                                {% endif %}
                            {% endif %}
                        </div>
                        <div class="card__row--location">
                            <img src="images/pin.png" alt="pin">
                            <h3>{{ offer.lieu }}</h3>
                        </div>
                        <div class="card__row--date">
                            <img src="images/salary.png" alt="salary">
                            <h3>{{ offer.annual_salary }}</h3>
                        </div>
                    </div>

                    <div class="card__description">
                        {{ description|raw }}
                    </div>


        {% if is_owner %}
            <form method="GET" action="/edit_offer">
                <input type="hidden" name="id_offer" value="{{ offer.id_offer }}">
                <button class="auth-submit">Modify my offer</button>
            </form>
        {% endif %}

        {% if role === 'etudiant' %}
            {% if not hasapplied %}
                <form method="GET" action="/apply">
                    <input type="hidden" name="id_offer" value="{{ offer.id_offer }}">
                    <button type="submit" class="auth-submit">Apply to this offer</button>
                </form>
            {% else %}
                <button class="auth-submit">You have already applied to this offer</buton>
            {% endif %}
    {% endif %}

        </div>
    </main>
</div>

{% endblock %}