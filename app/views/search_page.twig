{% extends "navbar.twig" %}

{% block content %}

<link rel="stylesheet" href="assets/components/card.css">
<link rel="stylesheet" href="assets/pages/search.css">

    <main class="search-page">
        <div class="search-toggle">
            <a class="search-toggle__btn search-toggle__btn--offers {{ search_type == 'offers' ? 'is-active' : 'is-inactive' }}" href={{ offers_btn_url }}>Chercher une offre</a>
            <a class="search-toggle__btn search-toggle__btn--companies {{ search_type == 'companies' ? 'is-active' : 'is-inactive' }}" href={{ companies_btn_url }}>Chercher une entreprise</a>
        </div>

        <form method="get" action="/search_page">
                <input type="hidden" name="search_type" value="{{ search_type }}">
                <select name="filter" id>
                <option value="">No filters</option>
                    {% for filter in filters %}
                        {% if search_type == 'offers' and filter.sector_name == filter_value %}
                            <option value="{{ filter.domain_name }}"> {{ filter.domain_name }}</option>
                        {% else %}
                            <option value="{{ filter.sector_name }}">{{ filter.sector_name }}</option>
                        {% endif %}
                    {% endfor %}
                </select>
            <button type="submit">Filtrer</button>
        </form>
                    
        <section class="feed">

            {% if search_type == 'offers' %}
                {% for offer in cards %}
                    <section class="job-card">
                        <div class="card__banner">
                            <a class="card__banner-img" href="/profile?id_user={{ offer.id_user }}&role=entreprise"> <img src="{{ offer.banner_path }}" alt="Image de l'entreprise"></a>
                            <a class="card__company-logo" href="/profile?id_user={{ offer.id_user }}&role=entreprise"> <img src="{{ offer.logo_path }}" alt="Logo entreprise"></a>
                        </div>
        
                        <a class="card__body" href="/offer_description?id_offer={{ offer.id_offer }}">
                            <h2 class="card__title"> {{ offer.offer_object }} </h2>
                            <div class = "card__row--type">
                                <img src="images/suitcase.png" alt="suitcase">
                                <h3> {{ offer.company_name }} </h3>
                            </div>
                            <div class = "card__row--location">
                                <img src="images/pin.png" alt="pin">
                                <h3> {{ offer.lieu }} </h3>
                            </div>
                            <div class = "card__row--date">
                                <h5> {{ offer.release_date }} </h5>
                                {% if role == 'etudiant' %}
                                    {% if offer.id_offer in offersinwishlist|map(o => o.id_offer) %}
                                        <img class="card__wishlist" src="images/wishlist_full.png" alt="wishlist_full">
                                    {% else %}
                                        <img class="card__wishlist" src="images/wishlist.png" alt="wishlist">
                                    {% endif %}
                                {% endif %}
                            </div>
                        </a>
                    </section>
                {% endfor %}
            {% endif %}

            {% if search_type == 'companies' %}
                {% for company in cards %}
                    <section class="job-card">
                        <div class="card__banner">
                            <a class="card__banner-img" href="/profile?id_user={{ company.id_user }}&role=entreprise"> <img src="{{ company.banner_path }}" alt="Image de l'entreprise"></a>
                            <a class="card__company-logo" href="/profile?id_user={{ company.id_user }}&role=entreprise"> <img src="{{ company.logo_path }}" alt="Logo entreprise"></a>
                        </div>

                        <a class="card__body" href="/profile?id_user={{ company.id_user }}&role=entreprise">
                            <h2 class="card__title"> {{ company.company_name }} </h2>
                        </a>
                    </section>
                {% endfor %}
            {% endif %}
        </section>
        
        <nav class="pagination">
            {% if page > 1 %}
                <a class="pagination__nav pagination__nav--prev" href="{{ prev_page_url }}" aria-label="Page precedente" title="Page precedente"></a>
            {% endif %}

            <span class="pagination__info">Page {{ page }} / {{ total_pages }}</span>

            {% if page < total_pages %}
                <a class="pagination__nav pagination__nav--next" href="{{ next_page_url }}" aria-label="Page suivante" title="Page suivante"></a>
            {% endif %}
        </nav>
    </main>

{% endblock %}