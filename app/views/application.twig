{% extends "navbar.twig" %}

{% block content %}
<br><br><br><br><br>
<form class="profile-form" data-role="{{ role }}" action="/apply" method="post" enctype="multipart/form-data">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <input type="hidden" name="id_offer" value="{{ id_offer }}"> 
    <p> CV (PDF): </p>
    <input type="file" name="cv" accept=".pdf" required>
    <p> Motivation Letter (PDF): </p>
    <input type="file" name="motivation_letter" accept=".pdf" required>
    <button type="submit">Submit Application</button>
</form>

{% if error %}
    <p style="color: red;">{{ error }}</p>
{% endif %}

<br><br><br><br><br>
{% endblock %}