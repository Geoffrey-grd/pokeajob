{% extends "navbar.twig" %}

{% block content %}
<link rel="stylesheet" href="https://unpkg.com/easymde/dist/easymde.min.css">
<link rel="stylesheet" href="/assets/pages/create-offer.css">
<link rel="stylesheet" href="/assets/components/form.css">
<script src="/js/form-validation.js" defer></script>
<script src="https://unpkg.com/easymde/dist/easymde.min.js"></script>
<div class="offer-container">
<form class="auth-form" method="POST">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    {% if editmode %}
        <input type="hidden" name="id_offer" value="{{ offer.id_offer }}">
    {% endif %}

  <div class="form-group">
    <div class="input-wrapper">
      {% if editmode %}
        <input type="text" name="offer_object" placeholder="Title" value="{{ offer.offer_object }}" required>
      {% else %}
        <input type="text" name="offer_object" placeholder="Title" required>
      {% endif %}
      <span class="validation-icon"></span>
    </div>
    <small class="error-message"></small>
  </div>

  <div class="form-group">
    <div class="input-wrapper">
      <select name="domain" id="domain" class="form-select" required>

        <option value="">Select a domain</option>
        {% for domain in domains %}
          <option value="{{ domain.id_domain }}" {% if editmode and offer.id_domain == domain.id_domain %}selected{% endif %}>{{ domain.domain_name }}</option>
        {% endfor %}
      </select>
      <span class="validation-icon"></span>
    </div>
    <small class="error-message"></small>
  </div>

  <div class="form-group">
    <div class="input-wrapper">
      {% if editmode %}
        <input type="text" name="lieu" placeholder="Place" value="{{ offer.lieu }}" required>
      {% else %}
        <input type="text" name="lieu" placeholder="Place" required>
      {% endif %}
      <span class="validation-icon"></span>
    </div>
    <small class="error-message"></small>
  </div>

  <div class="form-group">
    <div class="input-wrapper">
      {% if editmode %}
        <input type="text" name="annual_salary" placeholder="annual_salary" value="{{ offer.annual_salary }}" required>
      {% else %}
        <input type="text" name="annual_salary" placeholder="annual_salary" required>
      {% endif %}
      <span class="validation-icon"></span>
    </div>
    <small class="error-message"></small>
  </div>

  <div class="form-group">
    <div class="input-wrapper">
      {% if editmode %}
        <textarea id="markdown-editor" name="description">{{ offer.description }}</textarea>
      {% else %}
        <textarea id="markdown-editor" name="description"></textarea>
      {% endif %}
    </div>
    <small class="error-message"></small>
  </div>
  {% if editmode %}
      <button type="submit" class="auth-submit" formaction="/edit_offer_save">Save Changes</button>
  {% else %}
      <button type="submit" class="auth-submit" formaction="/create_offer">Publish</button>
  {% endif %}
  
</form>
</div>

<script>
  const easyMDE = new EasyMDE({
    element: document.getElementById("markdown-editor"),
    spellChecker: false,
    forceSync: true
  });

  easyMDE.codemirror.on("change", () => {
    const source = document.getElementById("markdown-editor");
    source.dispatchEvent(new Event("input", { bubbles: true }));
  });
</script>
{% endblock %}