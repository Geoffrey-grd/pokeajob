<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion - PokeAJob</title>
    <link rel="stylesheet" href="assets/core.css">
    <link rel="stylesheet" href="assets/form.css">
    <link rel="stylesheet" href="assets/auth.css">
    <script src="js/auth.js" defer></script>
</head>
<body class="page-auth">
    <!-- Bloc central: logo + formulaire dynamique. -->
    <main>
        <div class="login-container">
            <div class="login-box">
                <div class="logo">
                    <img src="images/Logo_PokeAJob.png" alt="PokeAJob" class="logo-img">
                </div>

                <div class="form-container">
                    <!-- Choix du mode: connexion ou inscription. -->
                    <div class="auth-switch" role="tablist" aria-label="Choisir le mode d'authentification">
                        <button id="mode-login" class="auth-switch__btn is-active" type="button" data-mode="login" role="tab" aria-selected="true">Connexion</button>
                        <button id="mode-signup" class="auth-switch__btn" type="button" data-mode="signup" role="tab" aria-selected="false">Inscription</button>
                    </div>

                    <h2 id="auth-title">CONNEXION</h2>

                    <!-- Formulaire -->
                    <form class="login-form" action="/loginregister" method="post">
                        <input id="auth-mode" name="auth_mode" type="hidden" value="login">
                        <div class="form-group signup-only is-hidden">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                            <label>Type de compte</label>
                            <div class="auth-switch auth-switch--roles" role="tablist" aria-label="Choisir un type de compte">
                                <button type="button" class="auth-switch__btn role-switch__btn is-active" data-role="etudiant">Etudiant</button>
                                <button type="button" class="auth-switch__btn role-switch__btn" data-role="entreprise">Entreprise</button>
                                <button type="button" class="auth-switch__btn role-switch__btn" data-role="pilote">Pilote</button>
                            </div>
                            <input name="account_type" id="account-type" type="hidden" value="etudiant">
                        </div>

                        <div class="form-group role-student role-pilote signup-only is-hidden">
                            <label for="name">Prenom</label>
                            <input name="name" id="name" type="text" placeholder="Prenom">
                        </div>

                        <div class="form-group role-student role-pilote signup-only is-hidden">
                            <label for="last-name">Nom</label>
                            <input name="last_name" id="last-name" type="text" placeholder="Nom">
                        </div>



                        <div class="form-group role-company signup-only is-hidden">
                            <label for="company-name">Nom de l'entreprise</label>
                            <input name="company_name" id="company-name" type="text" placeholder="Nom de l'entreprise">
                        </div>

                        {# <div class="form-group role-company signup-only is-hidden">
                            <label for="activity-sector">Secteur d'activite</label>
                            <input name="activity_sector" id="activity-sector" type="text" placeholder="Secteur d'activite">
                        </div> #}

                        <div class="form-group role-company signup-only is-hidden">
                            <label for="company-address">Adresse</label>
                            <input name="company_address" id="company-address" type="text" placeholder="Adresse">
                        </div>

                        <div class="form-group">
                            <label for="email">Email</label>
                            <input name="email" id="email" type="email" placeholder="Email" required>
                        </div>

                        <div class="form-group role-company role-pilote signup-only is-hidden">
                            <label for="phone">Telephone</label>
                            <input name="phone" id="phone" type="tel" placeholder="Telephone">
                        </div>

                        <div class="form-group">
                            <label for="password">Mot de passe</label>
                            <input name="password" id="password" type="password" placeholder="Mot de passe" required>
                        </div>

                        <div class="form-group role-company signup-only is-hidden">
                            <label for="confirm-password">Confirmer le mot de passe</label>
                            <input name="confirm_password" id="confirm-password" type="password" placeholder="Confirmer le mot de passe">
                        </div>

                        <div class="form-group role-student role-pilote signup-only is-hidden">
                            <label for="school">Etablissement</label>
                            <select name="school" id="school" class="form-select">
                                <option value="">Choisir un etablissement</option>
                                <option value="paris1">Universite Paris 1</option>
                                <option value="polytechnique">Ecole Polytechnique</option>
                                <option value="hec">HEC Paris</option>
                            </select>
                        </div>

                        <div class="form-group role-student signup-only is-hidden">
                            <label for="training-pilot">Pilote de formation</label>
                            <select name="training_pilot" id="training-pilot" class="form-select">
                                <option value="">Choisir un pilote</option>
                                <option value="dupont">M. Dupont</option>
                                <option value="martin">Mme Martin</option>
                            </select>
                        </div>

                        <div class="form-group role-company signup-only is-hidden">
                            <label for="company-ciret">ciret</label>
                            <input name="company_ciret" id="company-ciret" type="text" placeholder="ciret">
                        </div>



                        {# <div class="form-options login-only">
                            <div class="checkbox-group">
                                <input type="checkbox" id="remember">
                                <label for="remember">Enregistrer mes informations</label>
                            </div>
                        </div> #}

                        {# <div class="form-options signup-only is-hidden">
                            <div class="checkbox-group">
                                <input type="checkbox" id="terms">
                                <label for="terms">J'accepte les conditions d'utilisation</label>
                            </div>
                        </div> #}

                        <button id="submit-btn" type="submit" class="login-btn">CONNEXION</button>

                        

                        {# <div class="form-links login-only">
                            <a href="connexion.html" class="forgot-password">Mot de passe oublie ?</a>
                        </div>

                        <div class="form-links">
                            <p id="switch-text">Pas de compte ? <a href="#" id="switch-link" class="register-link">Inscrivez-vous</a></p>
                        </div> #}
                    </form>
                </div>
                {% if error %}
                    <p style="color:red;">{{ error }}</p>
                {% endif %}
            </div>
        </div>
    </main>
</body>
</html>   