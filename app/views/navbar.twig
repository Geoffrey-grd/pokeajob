<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="assets/base/core.css">
    <link rel="stylesheet" href="assets/components/navbar.css">
    <script src="js/burger_menu.js" defer></script>
    <title>PokeAJob - Accueil</title>

    <link rel="icon" type="image/png" sizes="32x32" href="images/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="images/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="images/pokeball-apple-touch-icon.png">
    <link rel="shortcut icon" href="favicon.ico">
</head>




<body>
    <header>
        <nav class="navbar--top">   
            <button id="openbtn" class="navbar__menu" aria-label="Ouvrir le menu" aria-expanded="false">
                <span class="burger-icon">
                    <span></span>
                    <span></span>
                    <span></span>
                </span>
            </button>

            <!-- Menu lateral ouvert/ferme par le bouton burger. -->
            <div id="burger-menu" class="burger-menu" aria-hidden="true">
                <button id="closebtn" type="button" class="burger-menu__close" aria-label="Fermer le menu">
                    <span class="burger-icon burger-icon--close">
                        <span></span>
                        <span></span>
                        <span></span>
                    </span>
                </button>

                <ul class="menu menu--main">
                    {% if role == 'etudiant' %}
                    <li><a href="/search_page">Offers</a></li>
                    <li><a href="/search_companies">Companies</a></li>
                    <li><a href="/wishlist">Wishlist</a></li>
                    <li><a href="/boo">Internship tracker</a></li>
                    {% endif %}

                    {% if role == 'entreprise' %}   
                    <li><a href="/search_page">Offers</a></li>
                    <li><a href="/search_companies">Companies</a></li>
                    <li><a href="/my_offers">My offers</a></li>
                    <li><a href="/create_offer">Create a new offer</a></li>
                    <li><a href="/boo">My notifications</a></li>
                    {% endif %}

                    {% if role == 'pilote' %}
                    <li><a href="/search_page">Offers</a></li>
                    <li><a href="/search_companies">Companies</a></li>
                    <li><a href="/boo">My students</a></li>
                    {% endif %}
                </ul>
                <ul class="menu menu--footer">
                    <li><a href="/legal_mentions">Mentions Légales</a></li>
                    <li><a href="/logout">Déconnexion</a></li>
                </ul>
            </div>
            <!-- Fond sombre clique pour fermer le menu. -->
            <div id="menu-overlay" class="menu-overlay" aria-hidden="true"></div>

            <a class="navbar__logo" href="/search_page"> <img src="images/Logo_PokeAJob.png" alt="Logo du site"></a>
            <a class="navbar__profile" href="/profile"> <img src="images/Profile.png" alt="Logo de profil"></a>
        </nav>
    </header>



    {% block content %}
    {% endblock %}
    
    {% if role == 'etudiant' %}
        <!-- Barre de navigation basse étudiant(tableau, recherche, favoris). -->
    <footer>
        <nav class="navbar--bottom">
            <a class="navbar__table" href="index.html"> <img src="images/table.png" alt="Table"></a>
            <a class="navbar__search" href="/search_page"> <img src="images/search.png" alt="Recherche"></a>
            <a class="navbar__wishlist" href="/wishlist"> <img src="images/wishlist_menu.png" alt="Wishlist"></a>
        </nav>
    </footer>
    {% endif %}

    {% if role == 'entreprise' %}
        <!-- Barre de navigation basse entreprise(tableau, recherche, favoris). -->
    <footer>
        <nav class="navbar--bottom">
            <a class="navbar__notif" href="/my_offers"> <img src="images/email.png" alt="Notification"></a>
            <a class="navbar__search" href="/search_page"> <img src="images/search.png" alt="Recherche"></a>
            <a class="navbar__my-offers" href="/create_offer"> <img src="images/plus.png" alt="Wishlist"></a>
            
        </nav>
    </footer>
    {% endif %}

    {% if role == 'pilote' %}   
        <!-- Barre de navigation basse pilote(tableau, recherche, favoris). -->
    <footer>
        <nav class="navbar--bottom">
            <!-- <a class="navbar__table" href="index.html"> <img src="images/table.png" alt="Table"></a> -->
            <a class="navbar__search" href="/search_page"> <img src="images/search.png" alt="Recherche"></a>
            <a class="navbar__students" href="search.html"> <img src="images/student.png" alt="Wishlist"></a>
        </nav>
    </footer>
    {% endif %}


</body>


</html>
