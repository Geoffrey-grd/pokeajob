{% extends "navbar.twig" %}

{% block content %}
<link rel="stylesheet" href="assets/components/form.css">
<link rel="stylesheet" href="assets/pages/auth.css">
<link rel="stylesheet" href="assets/pages/profil.css">
<script src="js/form-validation.js" defer></script>
<div class="page-auth">
<main>
<div class="auth-container">
<div class="auth-box">
    {% if role == 'etudiant' and editmode == false %}
        <!-- Avatar (modifiable)-->
        <div class="profile-avatar-wrap">
            {% if userData.profile_pic_path %}
                <img src="{{ userData.profile_pic_path }}" alt="Avatar" class="profile-avatar">
            {% else %}
                <img src="images/Profile.png" alt="Avatar" class="profile-avatar">
            {% endif %}
        </div>

        <!-- name / last_name (modifiable) -->
        <div class="profile-info-wrap">
            <label class="label-profil">Name:</label>
            <span class="profil-info">{{ userData['last_name'] }} {{ userData['name'] }}</span>
        </div>

        <!-- Email (modifiable) -->
        <div class="profile-info-wrap"> 
            <label class="label-profil">Email:</label>
            <span class="profil-info">{{ userData['email'] }}</span>
        </div>
    
        <!-- Etablissement (modifiable) -->
        <div class="profile-info-wrap">
            <label class="label-profil">School:</label>
            <span class="profil-info">{{ userData['school'] }}</span>
        </div>

        <!-- Pilote de formation (non modifiable) -->
        <div class="profile-info-wrap">
            <label class="label-profil">Pilot:</label>
            <span class="profil-info">{{ userData['pilot_last_name'] }}  {{ userData['pilot_name'] }}</span>
        </div>

        <!-- Description (modifiable) -->
        <div class="profile-info-wrap">
            <label class="label-profil">Description:</label>
            <span class="profil-info">{{ userData['description'] }}</span>
        </div>



    {% elseif role == 'etudiant' and editmode == true %}
        <form class="auth-form" data-role="{{ role }}" action="/modify_profile" method="post" enctype="multipart/form-data">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <input type="file" name ="profile_pic" accept="image/*">

            <div class="form-group">
                <label class="label-profil">Last name:</label>
                <div class="input-wrapper">
                    <input type="text" name="last_name" value="{{ userData['last_name'] }}">
                    <span class="validation-icon"></span>
                </div>
                <span class="error-message"></span>
            </div>
            <div class="form-group">
                <label class="label-profil">Name:</label>
                <div class="input-wrapper">
                    <input type="text" name="name" value="{{ userData['name'] }}">
                    <span class="validation-icon"></span>
                </div>
                <span class="error-message"></span>
            </div>
            <div class="form-group">
                <label class="label-profil">Email:</label>
                <div class="input-wrapper">
                    <input type="email" name="email" value="{{ userData['email'] }}">
                    <span class="validation-icon"></span>
                </div>
                <span class="error-message"></span>
            </div>
            <div>
                <label class="label-profil">Description:</label>
                <textarea name="description">{{ userData['description'] }}</textarea>
            </div>

            <button type="submit" class="auth-submit">Save changes</button>
        </form>



    {% elseif role == 'pilote' and editmode == false %}
        <!-- Avatar (modifiable) -->
        <div class="profile-avatar-wrap">
            {% if userData.profile_pic_path %}
                <img src="{{ userData.profile_pic_path }}" alt="Avatar" class="profile-avatar">
            {% else %}
                <img src="images/Profile.png" alt="Avatar" class="profile-avatar">
            {% endif %}
        </div>

        <!-- name / last_name (modifiable) -->
        <div class="profile-info-wrap">
            <label class="label-profil">Name:</label>
            <span class="profil-info">{{ userData['last_name'] }} {{ userData['name'] }}</span>
        </div>

        <!-- Email (modifiable) -->
        <div class="profile-info-wrap"> 
            <label class="label-profil">Email:</label>
            <span class="profil-info">{{ userData['email'] }}</span>
        </div>

        <!-- Telephone (modifiable) -->
        <div class="profile-info-wrap">
            <label class="label-profil">Phone:</label>
            <span class="profil-info">{{ userData['phone'] }}</span>
        </div>

        <!-- Etablissement (modifiable) -->
        <div class="profile-info-wrap">
            <label class="label-profil">School:</label>
            <span class="profil-info">{{ userData['school'] }}</span>
        </div>


    {% elseif role == 'pilote' and editmode == true %}
        <form class="auth-form" data-role="{{ role }}" action="/modify_profile" method="post" enctype="multipart/form-data">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <input type="file" name ="profile_pic" accept="image/*">

            <div class="form-group">
                <label class="label-profil">Last name:</label>
                <div class="input-wrapper">
                    <input type="text" name="last_name" value="{{ userData['last_name'] }}">
                    <span class="validation-icon"></span>
                </div>
                <span class="error-message"></span>
            </div>
            <div class="form-group">
                <label class="label-profil">Name:</label>
                <div class="input-wrapper">
                    <input type="text" name="name" value="{{ userData['name'] }}">
                    <span class="validation-icon"></span>
                </div>
                <span class="error-message"></span>
            </div>
            <div class="form-group">
                <label class="label-profil">Email:</label>
                <div class="input-wrapper">
                    <input type="email" name="email" value="{{ userData['email'] }}">
                    <span class="validation-icon"></span>
                </div>
                <span class="error-message"></span>
            </div>
            <div class="form-group">
                <label class="label-profil">Phone:</label>
                <div class="input-wrapper">
                    <input type="text" name="phone" value="{{ userData['phone'] }}">
                    <span class="validation-icon"></span>
                </div>
                <span class="error-message"></span>
            </div>
            <div class="form-group">
                <label class="label-profil">School:</label>
                <div class="input-wrapper">
                    <input type="text" name="school" value="{{ userData['school'] }}">
                    <span class="validation-icon"></span>
                </div>
                <span class="error-message"></span>
            </div>
            <button type="submit" class="auth-submit">Save changes</button>
        </form>



    {% elseif role == 'entreprise' and editmode == false %}
        <div class="company-hero">
            <!-- banniere de l'entreprise -->
            <div class="company-banner-wrap">
                {% if userData.banner_path %}
                    <img src="{{ userData.banner_path }}" alt="Banner" class="company-banner">
                {% endif %}
            </div>

            <!-- Logo de l'entreprise superpose a gauche -->
            <div class="company-logo-overlay">
                {% if userData.logo_path %}
                    <img src="{{ userData.logo_path }}" alt="Logo" class="profile-avatar">
                {% else %}
                    <img src="images/Profile.png" alt="Avatar" class="profile-avatar">
                {% endif %}
            </div>
        </div>

        <!-- name (modifiable) -->
        <div class="profile-info-wrap">
            <span class="profil-info">{{ userData['company_name'] }}</span>
        </div>

        <!-- Email (modifiable) -->
        <div class="profile-info-wrap"> 
            <label class="label-profil">Email:</label>
            <span class="profil-info">{{ userData['email'] }}</span>
        </div>

        <!-- Telephone (modifiable) -->
        <div class="profile-info-wrap">
            <label class="label-profil">Phone:</label>
            <span class="profil-info">{{ userData['phone'] }}</span>
        </div>

        <!-- Secteur d'activité (non modifiable) -->
        <div class="profile-info-wrap">
            <label class="label-profil">Activity sector:</label>
            <span class="profil-info">{{ userData['sector_name'] }}</span>
        </div>

        <!-- Description (modifiable) -->
        <div class="profile-info-wrap">
            <label class="label-profil">Description:</label>
            <span class="profil-info">{{ userData['description'] }}</span>
        </div>

        <!-- Ciret (non modifiable) -->
        <div class="profile-info-wrap">
            <label class="label-profil">Ciret:</label>
            <span class="profil-info">{{ userData['ciret'] }}</span>
        </div>

        <!-- rating (non modifiable) -->
        <div class="profile-info-wrap">
            <label class="label-profil">Rating:</label>
            <span class="profil-info">{{ userData['rating'] }}</span>
        </div>


    {% elseif role == 'entreprise' and editmode == true %}
        <form class="auth-form" data-role="{{ role }}" action="/modify_profile" method="post" enctype="multipart/form-data">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <label class="label-profil">Logo:</label>
            <input type="file" name ="logo" accept="image/*">
            <label class="label-profil">Banner:</label>
            <input type="file" name ="banner" accept="image/*">

            <div class="form-group">
                <label>Company name:</label>
                <div class="input-wrapper">
                    <input type="text" name="company_name" value="{{ userData['company_name'] }}">
                    <span class="validation-icon"></span>
                </div>
                <span class="error-message"></span>
            </div>
            <div class="form-group">
                <label class="label-profil">Email:</label>
                <div class="input-wrapper">
                    <input type="email" name="email" value="{{ userData['email'] }}">
                    <span class="validation-icon"></span>
                </div>
                <span class="error-message"></span>
            </div>
            <div class="form-group">
                <label class="label-profil">Phone:</label>
                <div class="input-wrapper">
                    <input type="text" name="phone" value="{{ userData['phone'] }}">
                    <span class="validation-icon"></span>
                </div>
                <span class="error-message"></span>
            </div>
            <div>
                <label class="label-profil">Description:</label>
                <textarea name="description">{{ userData['description'] }}</textarea>
            </div>

            <button type="submit" class="auth-submit">Save changes</button>
        </form>
    
    {% endif %}
    </div>
    {% if error %}
        <p style="color:red;">{{ error }}</p>
    {% endif %}

    {% if editmode == false %}
    <div class="profile-actions">
        <!-- Modifications -->
    <div>
        <a href="/edit_profile" class="auth-submit button-profil">Modify my informations</a>
    </div>

    <!-- Suppression de compte -->
    <div>
        <a href="/delete_account_page" class="auth-submit  button-profil">Delete my account</a>
    </div>
    </div>
    {% endif %}
    
</div>
</div>
</main>
</div>
{% endblock %}