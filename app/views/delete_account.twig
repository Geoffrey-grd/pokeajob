{% extends "navbar.twig" %}

{% block content %}
    <link rel="stylesheet" href="assets/components/form.css">
    <link rel="stylesheet" href="assets/pages/auth.css">
    <script src="js/form-validation.js" defer></script>
    <!-- Bloc central: logo + formulaire dynamique. -->
    <main>
        <div class="auth-container">
            <div class="auth-box">
                <div class="auth-logo">
                    <img src="images/Logo_PokeAJob.png" alt="PokeAJob" class="auth-logo-img">
                </div>
                <div class="form-container">

                    <!-- Formulaire -->
                    <form class="auth-form" action="/delete_account" method="post">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        <p style="color:red;">Êtes-vous sûr de vouloir supprimer votre compte ? Cette action est irréversible.</p>

                        <div class="form-group">
                            <label>Email</label>
                            <div class="input-wrapper">
                                <input name="email" id="email" type="email" placeholder="Email" required>
                                <span class="validation-icon"></span>
                            </div>
                            <span class="error-message"></span>
                        </div>

                        <div class="form-group">
                            <label>Password</label>
                            <div class="input-wrapper">
                                <input name="password" id="password" type="password" placeholder="Mot de passe" required>
                                <span class="validation-icon"></span>
                            </div>
                            <span class="error-message"></span>
                        </div>

                        <button id="submit-btn" type="submit" class="auth-submit">SUPPRIMER LE COMPTE</button>
                    </form>
                </div>
                {% if error %}
                    <p style="color:red;">{{ error }}</p>
                {% endif %}
            </div>
        </div>
    </main> 
{% endblock %}